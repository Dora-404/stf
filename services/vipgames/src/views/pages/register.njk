{% extends "layout.njk" %}
{% block content %}
<section class="panel auth">
  <h1>Register</h1>
  <form class="form-stack" onsubmit="vipRegister(event)">
    <label>Username
      <input id="register-username" name="username" type="text" autocomplete="username" required minlength="3" maxlength="32" pattern="[a-zA-Z0-9_]+" />
    </label>
    <label>Password
      <input id="register-password" name="password" type="password" autocomplete="new-password" required minlength="8" maxlength="128" />
    </label>
    <button class="btn" type="submit">Create Account</button>
  </form>
  <div id="auth-message" class="notice" role="status" hidden></div>
  <p class="hint">Already have account? <a href="/login">Login</a></p>
</section>
{% endblock %}
