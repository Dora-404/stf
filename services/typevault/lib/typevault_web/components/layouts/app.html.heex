<%# App shell — rendered inside root.html.heex %>
<div class="flex flex-col min-h-screen">

  <%# ── Top nav ───────────────────────────────────────────────────────────── %>
  <header style="position:fixed;inset:0 0 auto;z-index:50;background:rgba(9,9,15,.88);backdrop-filter:blur(20px);border-bottom:1px solid rgba(255,255,255,.07);">
    <div style="max-width:1280px;margin:0 auto;height:60px;display:flex;align-items:center;justify-content:space-between;padding:0 1.5rem;">

      <div style="display:flex;align-items:center;gap:2rem;">
        <a href="/" style="font-size:1.1rem;font-weight:800;letter-spacing:-.03em;text-decoration:none;background:linear-gradient(135deg,#a78bfa,#06b6d4);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">TypeVault</a>
        <nav style="display:flex;gap:.25rem;">
          <a href="/gallery" style={"padding:.35rem .8rem;border-radius:6px;font-size:.85rem;text-decoration:none;transition:all .15s;" <> if @conn_or_lv_path == "/gallery", do: "background:rgba(124,58,237,.2);color:#a78bfa;", else: "color:#94a3b8;"}>Gallery</a>
          <a href="/tools/generate" style={"padding:.35rem .8rem;border-radius:6px;font-size:.85rem;text-decoration:none;transition:all .15s;" <> if @conn_or_lv_path == "/tools/generate", do: "background:rgba(124,58,237,.2);color:#a78bfa;", else: "color:#94a3b8;"}>TVF Generator</a>
          <%= if @current_user do %>
            <a href="/studio" style={"padding:.35rem .8rem;border-radius:6px;font-size:.85rem;text-decoration:none;transition:all .15s;" <> if String.starts_with?(@conn_or_lv_path, "/studio"), do: "background:rgba(124,58,237,.2);color:#a78bfa;", else: "color:#94a3b8;"}>Studio</a>
          <% end %>
        </nav>
      </div>

      <div style="display:flex;align-items:center;gap:.75rem;">
        <%= if @current_user do %>
          <div style="display:flex;align-items:center;gap:.75rem;">
            <div style="display:flex;align-items:center;gap:.5rem;padding:.3rem .75rem;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:8px;">
              <div style="width:22px;height:22px;border-radius:50%;background:linear-gradient(135deg,#7c3aed,#06b6d4);display:flex;align-items:center;justify-content:center;font-size:.65rem;font-weight:700;color:#fff;">
                <%= String.first(@current_user.username) |> String.upcase() %>
              </div>
              <span style="font-size:.82rem;color:#e2e8f0;"><%= @current_user.username %></span>
            </div>
            <form method="post" action="/logout" style="margin:0;">
              <input type="hidden" name="_csrf_token" value={get_csrf_token()}/>
              <input type="hidden" name="_method" value="delete"/>
              <button type="submit" style="padding:.35rem .75rem;border-radius:6px;font-size:.82rem;color:#64748b;background:transparent;border:1px solid rgba(255,255,255,.07);cursor:pointer;transition:all .15s;">Sign out</button>
            </form>
          </div>
        <% else %>
          <a href="/login"    style="padding:.4rem .9rem;border-radius:7px;font-size:.85rem;color:#94a3b8;text-decoration:none;border:1px solid rgba(255,255,255,.08);transition:all .15s;">Sign in</a>
          <a href="/register" style="padding:.4rem .9rem;border-radius:7px;font-size:.85rem;background:#7c3aed;color:#fff;text-decoration:none;font-weight:500;transition:all .15s;">Get started</a>
        <% end %>
      </div>

    </div>
  </header>

  <%# ── Flash messages ────────────────────────────────────────────────────── %>
  <%= if msg = Phoenix.Flash.get(@flash, :info) do %>
    <div class="toast toast-ok" phx-click="lv:clear-flash" phx-value-key="info"><%= msg %></div>
  <% end %>
  <%= if msg = Phoenix.Flash.get(@flash, :error) do %>
    <div class="toast toast-err" phx-click="lv:clear-flash" phx-value-key="error"><%= msg %></div>
  <% end %>

  <%# ── Page content ───────────────────────────────────────────────────────── %>
  <main style="flex:1;padding-top:60px;">
    <div class="lv-page">
      <%= @inner_content %>
    </div>
  </main>

  <%# ── Footer ─────────────────────────────────────────────────────────────── %>
  <footer style="border-top:1px solid rgba(255,255,255,.06);padding:1.25rem 1.5rem;margin-top:auto;">
    <div style="max-width:1280px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:.75rem;">
      <p style="color:#475569;font-size:.78rem;">© 2024 TypeVault, Inc. Professional font design platform.</p>
      <div style="display:flex;gap:1.5rem;">
        <a href="/gallery" style="color:#475569;font-size:.78rem;text-decoration:none;">Gallery</a>
        <a href="#" style="color:#475569;font-size:.78rem;text-decoration:none;">Docs</a>
        <a href="#" style="color:#475569;font-size:.78rem;text-decoration:none;">Status</a>
      </div>
    </div>
  </footer>

</div>
